# Tout est facultatif : Fullset démarre sans aucune variable.
# Everything is optional: Fullset starts without any variable.

# --- Métadonnées des jeux / Game metadata (IGDB, via Twitch) ---
# https://api-docs.igdb.com/#account-creation
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# --- Bibliothèque Steam / Steam library ---
# Clé : https://steamcommunity.com/dev/apikey ; SteamID64 : https://steamid.io
# Le profil doit avoir « Détails des jeux » en public. / Profile "Game details" must be public.
STEAM_API_KEY=
STEAM_ID=

# --- Reconnaissance des codes-barres / Barcode lookup (ScanDex) ---
SCANDEX_TOKEN=

# --- Lien vers RomM / Link to a RomM instance ---
ROMM_URL=
ROMM_API_TOKEN=

# --- Derrière un proxy inverse / Behind a reverse proxy ---
# Adresse(s) du proxy, crues pour l'IP du client et le HTTPS. / Proxy address(es) trusted for client IP and HTTPS.
TRUST_PROXY=
# Origines admises pour les écritures, si le proxy ne transmet pas X-Forwarded-Host.
# Origins allowed to write, if the proxy does not forward X-Forwarded-Host. Ex: https://fullset.example.org
ALLOWED_ORIGINS=
